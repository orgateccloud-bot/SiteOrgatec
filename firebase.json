{
  "hosting": {
    "public": "site",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://gibs.earthdata.nasa.gov; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/cotacoes/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'self' https://www.cepea.org.br; style-src 'unsafe-inline'; img-src https://cepea.org.br https://www.cepea.org.br data:; frame-ancestors 'self'; base-uri 'none'; form-action 'none'"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|svg|ico|jpg|webp|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/dados/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/setores/transporte.html",
        "destination": "/empresarial/transporte.html",
        "type": 301
      },
      {
        "source": "/setores/agro.html",
        "destination": "/rural/index.html",
        "type": 301
      },
      {
        "source": "/setores/janela-de-campo.html",
        "destination": "/rural/janela-de-campo.html",
        "type": 301
      },
      {
        "source": "/setores/agro-mercado.html",
        "destination": "/rural/cotacoes.html",
        "type": 301
      },
      {
        "source": "/setores/regional.html",
        "destination": "/reforma/alertas-regionais.html",
        "type": 301
      },
      {
        "source": "/tributario/index.html",
        "destination": "/consultoria-tributaria.html",
        "type": 301
      },
      {
        "source": "/escritorio/index.html",
        "destination": "/quem-somos.html",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "orgatec-api",
          "region": "southamerica-east1"
        }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8085
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
