# Copie para .env (que NÃO vai para o git) ou cadastre como variáveis na plataforma de hospedagem.

# Obrigatório no servidor publicado: segredo do HMAC que guarda os IPs (mín. 32 caracteres).
# Gere um com:  python -c "import secrets; print(secrets.token_hex(32))"
# Depois de definido, NÃO troque: os IPs já gravados deixam de ser comparáveis.
ORGATEC_SEGREDO_IP=

# Domínio(s) do site, separados por vírgula (CORS da API)
ORGATEC_ORIGENS=https://orgatec.io

# "1" no servidor publicado (exige o segredo acima e liga o HSTS)
ORGATEC_PRODUCAO=1

# Homologação: deixe 0 para manter o site fora dos buscadores (X-Robots-Tag: noindex).
# Só troque para 1 quando config.js estiver em ambiente 'producao' e o painel de testes sem bloqueios.
ORGATEC_INDEXAR=0

# Prazos de guarda em dias (padrão: política de privacidade, seção 5). A eliminação roda em tools/lgpd.py.
# ORGATEC_RETENCAO_LEAD_DIAS=730
# ORGATEC_RETENCAO_CONTATO_DIAS=730
# ORGATEC_RETENCAO_OPTIN_PENDENTE_DIAS=30

# Requisições por IP a cada 10 minutos nos formulários
ORGATEC_RATE_LIMIT=20

# Cabeçalho com o IP real do visitante posto pelo proxy da hospedagem. Railway: x-real-ip.
ORGATEC_CABECALHO_IP=

# "0" quando o site estático fica no Firebase Hosting e este serviço é só a API
ORGATEC_SERVIR_SITE=1

# IPs do proxy da plataforma para ler o IP real do visitante. "*" só se o contêiner não for acessível direto.
ORGATEC_PROXY_IPS=127.0.0.1

# Banco: "sqlite" (local, Docker, Railway com volume) ou "firestore" (Cloud Run, que tem disco efêmero)
ORGATEC_BANCO=sqlite
# Projeto do Google para o Firestore, se diferente do padrão do ambiente
ORGATEC_FIRESTORE_PROJETO=

# Posição do IP no cabeçalho com lista (X-Forwarded-For): 0 = primeiro, -1 = último, -2 = penúltimo
ORGATEC_IP_POSICAO=0
# "1" registra os cabeçalhos de IP (último bloco mascarado) para calibrar a posição; desligue depois
ORGATEC_DIAGNOSTICO_IP=0

# Caminho do banco (monte um volume persistente em /dados)
ORGATEC_DB=/dados/orgatec.db
