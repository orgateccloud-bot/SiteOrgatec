# Central de Viagem — variáveis de ambiente (prefixo TRANSPORTE_). Sem valores reais aqui.

# Ambiente: desenvolvimento | homologacao | producao. Em producao o modo de autenticação "dev" é recusado na subida.
TRANSPORTE_AMBIENTE=desenvolvimento

# Banco. PostgreSQL em produção (ex.: postgresql+psycopg://usuario:senha@host:5432/banco). SQLite só para teste local.
TRANSPORTE_DATABASE_URL=sqlite:///./transporte.db

# Chave Fernet (base64, 32 bytes) que cifra os segredos HMAC dos sensores. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRANSPORTE_CHAVE_CRIPTO=

# Chave que assina os tokens curtos do canal em tempo real (SSE). Qualquer texto aleatório longo.
TRANSPORTE_CHAVE_STREAM=

# Autenticação: dev (cabeçalhos X-Transportadora-Id / X-Usuario-Papel; só fora de produção) | externo (integrar ao login do sistema).
TRANSPORTE_AUTH_MODO=dev

# ---- Flags: TODAS desligadas por padrão. Desligada = usa o provedor simulado. ----
TRANSPORTE_ROTA_REAL=false          # OpenRouteService (precisa de TRANSPORTE_ORS_CHAVE)
TRANSPORTE_CLIMA_REAL=false         # MET Norway (precisa de TRANSPORTE_METNO_USER_AGENT)
TRANSPORTE_COMBUSTIVEL_REAL=false   # CSV normalizado da ANP (TRANSPORTE_ANP_ARQUIVO)
TRANSPORTE_PEDAGIO_REAL=false       # CSV de praças da ANTT (TRANSPORTE_ANTT_PRACAS_ARQUIVO)
TRANSPORTE_BLOQUEIO_MANUAL=false    # Bloqueios cadastrados no banco em vez dos simulados
TRANSPORTE_SENSORES_ATIVO=false     # Cadastro de sensores, entrada de telemetria e tempo real

# Chave do OpenRouteService (plano gratuito: 2.000 rotas/dia, 40/min — conferido em openrouteservice.org/plans em 08/11/2026).
TRANSPORTE_ORS_CHAVE=
TRANSPORTE_ORS_URL=https://api.openrouteservice.org

# MET Norway exige User-Agent que identifique o app e um contato (ex.: "OrgatecCentral/0.1 contato@dominio").
TRANSPORTE_METNO_USER_AGENT=
TRANSPORTE_METNO_URL=https://api.met.no/weatherapi/locationforecast/2.0/compact

# Arquivos locais gerados por rotinas de importação (formato documentado no README).
TRANSPORTE_ANP_ARQUIVO=./dados/anp_precos.csv
TRANSPORTE_ANTT_PRACAS_ARQUIVO=./dados/antt_pracas.csv

# Integrações externas: timeout (s), tentativas e validade do cache (s).
TRANSPORTE_HTTP_TIMEOUT=10
TRANSPORTE_HTTP_TENTATIVAS=3
TRANSPORTE_CACHE_TTL_ROTA=86400
TRANSPORTE_CACHE_TTL_CLIMA=1800
